# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Build artifacts
/bin/
/build/
/dist/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary files
*.tmp
*.temp
/tmp/

# Log files
*.log

# Environment variables
.env
.env.local
.env.*.local

# Coverage reports
coverage.txt
coverage.html
coverage.out

# Benchmark results
*.bench

# Profiling data
*.prof
*.pprof

# Research/experimental files
experiments/
scratch/
*.draft

# Documentation build artifacts
/docs/build/

# AI assistant files (but keep copilot-instructions.md)
.claude/
.cursor/
.windsurf/
.clinerules
.cursorrules
.windsurfrules

# MATLAB artifacts (for reference comparison)
*.asv
*.m~

# Cache
.cache/



# Compiled example binaries. `go build` inside an examples/ subdirectory drops
# an extensionless binary named after its directory, which no rule above
# matches on Linux.
examples/*/[a-z]*
!examples/*/*.go
!examples/*/go.mod
!examples/*/go.sum
!examples/*/README.md
# The WebAssembly demo is an examples/ subdirectory whose sources are static
# assets rather than Go files, so the rule above would swallow every one of
# them.
!examples/*/*.html
!examples/*/*.css
!examples/*/*.js
!examples/*/*.svg
# examples/ is itself a module, so `go build` there drops examples/examples.
examples/examples
# `go build ./...` inside the demo module drops a binary named after it. The
# rule above already catches it; naming it keeps the reason visible.
/examples/wasm-demo/wasm-demo
